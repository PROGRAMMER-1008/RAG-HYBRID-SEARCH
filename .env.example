APP_ENV=development
GENERATION_PROVIDER=ollama
JUDGE_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MAX_ANSWER_TOKENS=1024
MAX_JUDGE_TOKENS=256
MAX_CITATION_CHECKS_PER_ANSWER=8
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_RERANKER=true
ENABLE_CITATION_VERIFICATION=true
ENABLE_OCR=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_UPLOAD_FILE_BYTES=15728640
MAX_WORKSPACE_BYTES=52428800
MAX_UPLOAD_REQUEST_BYTES=62914560
MAX_PAGES_PER_FILE=500
MAX_FILES_PER_WORKSPACE=100
WORKSPACE_TTL_MINUTES=45
MAX_OCR_PAGES_PER_FILE=30
MAX_CHUNKS_PER_WORKSPACE=5000
MAX_ACTIVE_WORKSPACES=3
MAX_QUESTIONS_PER_WORKSPACE=10
MAX_DAILY_QUESTIONS=25
MAX_REQUESTS_PER_MINUTE=20
